{
  "name": "chat-export-md",
  "displayName": "Chat-Export (MD)",
  "description": "Exports the COPILOT-chat to a readable markdown file",
  "license": "MIT",
  "publisher": "EinWesen",
  "repository": {
    "type": "git",
    "url": "https://github.com/EinWesen/vscode-chat-export-md.git"
  },
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "einwesen.chat-export-md.export",
        "title": "Chat: Export Chat (Markdown) ..."
      }
    ],
    "configuration": {
      "title": "Chat Export (Markdown)",
      "properties": {
        "einwesen.chat-export-md.defaultToolCallMode": {
          "type": "string",
          "order": 1,
          "enum": [
            "alwaysAsk",
            "full",
            "summary",
            "omit"
          ],
          "enumItemLabels": [
            "Always ask",
            "Full",
            "Summary only",
            "Omit tool calls"
          ],
          "default": "alwaysAsk",
          "description": "Choose Always ask to select a tool-call mode on each export. The other options export directly using that mode."
        },
        "einwesen.chat-export-md.preferredToolCallMessage": {
          "type": "string",
          "order": 2,
          "enum": [
            "pastTenseMessage",
            "invocationMessage"
          ],
          "enumItemLabels": [
            "Past-tense message",
            "Invocation message"
          ],
          "default": "invocationMessage",
          "description": "Choose which tool-call message to prefer. If unavailable, the other message is used."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
